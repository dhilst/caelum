{
  "name": "caelum-codemirror",
  "version": "0.1.0",
  "description": "CodeMirror 6 editor for the Caelum LTL model checker: .lum syntax highlighting, inline diagnostics, and in-browser checking via caelum-wasm.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=esm --outfile=dist/caelum-editor.js --minify",
    "build:dev": "esbuild src/index.js --bundle --format=esm --outfile=dist/caelum-editor.js --sourcemap"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
