module examples.life4x4_universal

// Conway's Game of Life on a 4x4 toroidal grid with NO init block.
// Every cell configuration is an initial state. Properties express
// universal GoL laws that should hold from any starting configuration.

let c_0_0 ∈ 0..1
let c_0_1 ∈ 0..1
let c_0_2 ∈ 0..1
let c_0_3 ∈ 0..1
let c_1_0 ∈ 0..1
let c_1_1 ∈ 0..1
let c_1_2 ∈ 0..1
let c_1_3 ∈ 0..1
let c_2_0 ∈ 0..1
let c_2_1 ∈ 0..1
let c_2_2 ∈ 0..1
let c_2_3 ∈ 0..1
let c_3_0 ∈ 0..1
let c_3_1 ∈ 0..1
let c_3_2 ∈ 0..1
let c_3_3 ∈ 0..1

// (no init: 2^16 = 65536 initial states)

transition step {
  (c_0_0' = 1 ↔ ((c_3_3 + c_3_0 + c_3_1 + c_0_3 + c_0_1 + c_1_3 + c_1_0 + c_1_1) = 3 ∨ (c_0_0 = 1 ∧ (c_3_3 + c_3_0 + c_3_1 + c_0_3 + c_0_1 + c_1_3 + c_1_0 + c_1_1) = 2))) ∧
  (c_0_1' = 1 ↔ ((c_3_0 + c_3_1 + c_3_2 + c_0_0 + c_0_2 + c_1_0 + c_1_1 + c_1_2) = 3 ∨ (c_0_1 = 1 ∧ (c_3_0 + c_3_1 + c_3_2 + c_0_0 + c_0_2 + c_1_0 + c_1_1 + c_1_2) = 2))) ∧
  (c_0_2' = 1 ↔ ((c_3_1 + c_3_2 + c_3_3 + c_0_1 + c_0_3 + c_1_1 + c_1_2 + c_1_3) = 3 ∨ (c_0_2 = 1 ∧ (c_3_1 + c_3_2 + c_3_3 + c_0_1 + c_0_3 + c_1_1 + c_1_2 + c_1_3) = 2))) ∧
  (c_0_3' = 1 ↔ ((c_3_2 + c_3_3 + c_3_0 + c_0_2 + c_0_0 + c_1_2 + c_1_3 + c_1_0) = 3 ∨ (c_0_3 = 1 ∧ (c_3_2 + c_3_3 + c_3_0 + c_0_2 + c_0_0 + c_1_2 + c_1_3 + c_1_0) = 2))) ∧
  (c_1_0' = 1 ↔ ((c_0_3 + c_0_0 + c_0_1 + c_1_3 + c_1_1 + c_2_3 + c_2_0 + c_2_1) = 3 ∨ (c_1_0 = 1 ∧ (c_0_3 + c_0_0 + c_0_1 + c_1_3 + c_1_1 + c_2_3 + c_2_0 + c_2_1) = 2))) ∧
  (c_1_1' = 1 ↔ ((c_0_0 + c_0_1 + c_0_2 + c_1_0 + c_1_2 + c_2_0 + c_2_1 + c_2_2) = 3 ∨ (c_1_1 = 1 ∧ (c_0_0 + c_0_1 + c_0_2 + c_1_0 + c_1_2 + c_2_0 + c_2_1 + c_2_2) = 2))) ∧
  (c_1_2' = 1 ↔ ((c_0_1 + c_0_2 + c_0_3 + c_1_1 + c_1_3 + c_2_1 + c_2_2 + c_2_3) = 3 ∨ (c_1_2 = 1 ∧ (c_0_1 + c_0_2 + c_0_3 + c_1_1 + c_1_3 + c_2_1 + c_2_2 + c_2_3) = 2))) ∧
  (c_1_3' = 1 ↔ ((c_0_2 + c_0_3 + c_0_0 + c_1_2 + c_1_0 + c_2_2 + c_2_3 + c_2_0) = 3 ∨ (c_1_3 = 1 ∧ (c_0_2 + c_0_3 + c_0_0 + c_1_2 + c_1_0 + c_2_2 + c_2_3 + c_2_0) = 2))) ∧
  (c_2_0' = 1 ↔ ((c_1_3 + c_1_0 + c_1_1 + c_2_3 + c_2_1 + c_3_3 + c_3_0 + c_3_1) = 3 ∨ (c_2_0 = 1 ∧ (c_1_3 + c_1_0 + c_1_1 + c_2_3 + c_2_1 + c_3_3 + c_3_0 + c_3_1) = 2))) ∧
  (c_2_1' = 1 ↔ ((c_1_0 + c_1_1 + c_1_2 + c_2_0 + c_2_2 + c_3_0 + c_3_1 + c_3_2) = 3 ∨ (c_2_1 = 1 ∧ (c_1_0 + c_1_1 + c_1_2 + c_2_0 + c_2_2 + c_3_0 + c_3_1 + c_3_2) = 2))) ∧
  (c_2_2' = 1 ↔ ((c_1_1 + c_1_2 + c_1_3 + c_2_1 + c_2_3 + c_3_1 + c_3_2 + c_3_3) = 3 ∨ (c_2_2 = 1 ∧ (c_1_1 + c_1_2 + c_1_3 + c_2_1 + c_2_3 + c_3_1 + c_3_2 + c_3_3) = 2))) ∧
  (c_2_3' = 1 ↔ ((c_1_2 + c_1_3 + c_1_0 + c_2_2 + c_2_0 + c_3_2 + c_3_3 + c_3_0) = 3 ∨ (c_2_3 = 1 ∧ (c_1_2 + c_1_3 + c_1_0 + c_2_2 + c_2_0 + c_3_2 + c_3_3 + c_3_0) = 2))) ∧
  (c_3_0' = 1 ↔ ((c_2_3 + c_2_0 + c_2_1 + c_3_3 + c_3_1 + c_0_3 + c_0_0 + c_0_1) = 3 ∨ (c_3_0 = 1 ∧ (c_2_3 + c_2_0 + c_2_1 + c_3_3 + c_3_1 + c_0_3 + c_0_0 + c_0_1) = 2))) ∧
  (c_3_1' = 1 ↔ ((c_2_0 + c_2_1 + c_2_2 + c_3_0 + c_3_2 + c_0_0 + c_0_1 + c_0_2) = 3 ∨ (c_3_1 = 1 ∧ (c_2_0 + c_2_1 + c_2_2 + c_3_0 + c_3_2 + c_0_0 + c_0_1 + c_0_2) = 2))) ∧
  (c_3_2' = 1 ↔ ((c_2_1 + c_2_2 + c_2_3 + c_3_1 + c_3_3 + c_0_1 + c_0_2 + c_0_3) = 3 ∨ (c_3_2 = 1 ∧ (c_2_1 + c_2_2 + c_2_3 + c_3_1 + c_3_3 + c_0_1 + c_0_2 + c_0_3) = 2))) ∧
  (c_3_3' = 1 ↔ ((c_2_2 + c_2_3 + c_2_0 + c_3_2 + c_3_0 + c_0_2 + c_0_3 + c_0_0) = 3 ∨ (c_3_3 = 1 ∧ (c_2_2 + c_2_3 + c_2_0 + c_3_2 + c_3_0 + c_0_2 + c_0_3 + c_0_0) = 2)))
}

// --- Universal safety properties ---

// All-dead is absorbing: the empty configuration is a fixed point.
property all_dead_absorbing {
  □ ((c_0_0 = 0 ∧ c_0_1 = 0 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 0 ∧ c_1_1 = 0 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0) → ◯ (c_0_0 = 0 ∧ c_0_1 = 0 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 0 ∧ c_1_1 = 0 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0))
}

// A single live cell has zero neighbours and dies in one step.
property lone_cell_dies {
  □ (((c_0_0 + c_0_1 + c_0_2 + c_0_3 + c_1_0 + c_1_1 + c_1_2 + c_1_3 + c_2_0 + c_2_1 + c_2_2 + c_2_3 + c_3_0 + c_3_1 + c_3_2 + c_3_3) = 1) → ◯ ((c_0_0 + c_0_1 + c_0_2 + c_0_3 + c_1_0 + c_1_1 + c_1_2 + c_1_3 + c_2_0 + c_2_1 + c_2_2 + c_2_3 + c_3_0 + c_3_1 + c_3_2 + c_3_3) = 0))
}

// All-alive has every cell with 8 alive neighbours; all die in one step.
property all_alive_dies {
  □ ((c_0_0 = 1 ∧ c_0_1 = 1 ∧ c_0_2 = 1 ∧ c_0_3 = 1 ∧ c_1_0 = 1 ∧ c_1_1 = 1 ∧ c_1_2 = 1 ∧ c_1_3 = 1 ∧ c_2_0 = 1 ∧ c_2_1 = 1 ∧ c_2_2 = 1 ∧ c_2_3 = 1 ∧ c_3_0 = 1 ∧ c_3_1 = 1 ∧ c_3_2 = 1 ∧ c_3_3 = 1) → ◯ (c_0_0 = 0 ∧ c_0_1 = 0 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 0 ∧ c_1_1 = 0 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0))
}

// An isolated 2x2 block at the origin is a still life on the 4x4 torus.
property isolated_block_persists {
  □ ((c_0_0 = 1 ∧ c_0_1 = 1 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 1 ∧ c_1_1 = 1 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0) → ◯ (c_0_0 = 1 ∧ c_0_1 = 1 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 1 ∧ c_1_1 = 1 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0))
}

// Population is bounded by the grid size.
property population_bounded {
  □ ((c_0_0 + c_0_1 + c_0_2 + c_0_3 + c_1_0 + c_1_1 + c_1_2 + c_1_3 + c_2_0 + c_2_1 + c_2_2 + c_2_3 + c_3_0 + c_3_1 + c_3_2 + c_3_3) ≥ 0 ∧ (c_0_0 + c_0_1 + c_0_2 + c_0_3 + c_1_0 + c_1_1 + c_1_2 + c_1_3 + c_2_0 + c_2_1 + c_2_2 + c_2_3 + c_3_0 + c_3_1 + c_3_2 + c_3_3) ≤ 16)
}

// --- Deliberately false ---

// Not every initial configuration is empty.
invalid all_initials_are_empty {
  □ (c_0_0 = 0 ∧ c_0_1 = 0 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 0 ∧ c_1_1 = 0 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0)
}

// Not every state has the corner block pattern.
invalid every_state_has_corner_block {
  □ (c_0_0 = 1 ∧ c_0_1 = 1 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 1 ∧ c_1_1 = 1 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0)
}
