module examples.life5x5_glider

// Conway's Game of Life on a 5x5 toroidal grid with a canonical glider
// initial. State space 2^25 ~ 33M; intentionally too large for the
// explicit engine. Designed as the headline demo for BMC.

let c_0_0 ∈ 0..1
let c_0_1 ∈ 0..1
let c_0_2 ∈ 0..1
let c_0_3 ∈ 0..1
let c_0_4 ∈ 0..1
let c_1_0 ∈ 0..1
let c_1_1 ∈ 0..1
let c_1_2 ∈ 0..1
let c_1_3 ∈ 0..1
let c_1_4 ∈ 0..1
let c_2_0 ∈ 0..1
let c_2_1 ∈ 0..1
let c_2_2 ∈ 0..1
let c_2_3 ∈ 0..1
let c_2_4 ∈ 0..1
let c_3_0 ∈ 0..1
let c_3_1 ∈ 0..1
let c_3_2 ∈ 0..1
let c_3_3 ∈ 0..1
let c_3_4 ∈ 0..1
let c_4_0 ∈ 0..1
let c_4_1 ∈ 0..1
let c_4_2 ∈ 0..1
let c_4_3 ∈ 0..1
let c_4_4 ∈ 0..1

init {
  c_0_0 = 0 ∧ c_0_1 = 1 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_0_4 = 0 ∧ c_1_0 = 0 ∧ c_1_1 = 0 ∧ c_1_2 = 1 ∧ c_1_3 = 0 ∧ c_1_4 = 0 ∧ c_2_0 = 1 ∧ c_2_1 = 1 ∧ c_2_2 = 1 ∧ c_2_3 = 0 ∧ c_2_4 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0 ∧ c_3_4 = 0 ∧ c_4_0 = 0 ∧ c_4_1 = 0 ∧ c_4_2 = 0 ∧ c_4_3 = 0 ∧ c_4_4 = 0
}

transition step {
  (c_0_0' = 1 ↔ ((c_4_4 + c_4_0 + c_4_1 + c_0_4 + c_0_1 + c_1_4 + c_1_0 + c_1_1) = 3 ∨ (c_0_0 = 1 ∧ (c_4_4 + c_4_0 + c_4_1 + c_0_4 + c_0_1 + c_1_4 + c_1_0 + c_1_1) = 2))) ∧
  (c_0_1' = 1 ↔ ((c_4_0 + c_4_1 + c_4_2 + c_0_0 + c_0_2 + c_1_0 + c_1_1 + c_1_2) = 3 ∨ (c_0_1 = 1 ∧ (c_4_0 + c_4_1 + c_4_2 + c_0_0 + c_0_2 + c_1_0 + c_1_1 + c_1_2) = 2))) ∧
  (c_0_2' = 1 ↔ ((c_4_1 + c_4_2 + c_4_3 + c_0_1 + c_0_3 + c_1_1 + c_1_2 + c_1_3) = 3 ∨ (c_0_2 = 1 ∧ (c_4_1 + c_4_2 + c_4_3 + c_0_1 + c_0_3 + c_1_1 + c_1_2 + c_1_3) = 2))) ∧
  (c_0_3' = 1 ↔ ((c_4_2 + c_4_3 + c_4_4 + c_0_2 + c_0_4 + c_1_2 + c_1_3 + c_1_4) = 3 ∨ (c_0_3 = 1 ∧ (c_4_2 + c_4_3 + c_4_4 + c_0_2 + c_0_4 + c_1_2 + c_1_3 + c_1_4) = 2))) ∧
  (c_0_4' = 1 ↔ ((c_4_3 + c_4_4 + c_4_0 + c_0_3 + c_0_0 + c_1_3 + c_1_4 + c_1_0) = 3 ∨ (c_0_4 = 1 ∧ (c_4_3 + c_4_4 + c_4_0 + c_0_3 + c_0_0 + c_1_3 + c_1_4 + c_1_0) = 2))) ∧
  (c_1_0' = 1 ↔ ((c_0_4 + c_0_0 + c_0_1 + c_1_4 + c_1_1 + c_2_4 + c_2_0 + c_2_1) = 3 ∨ (c_1_0 = 1 ∧ (c_0_4 + c_0_0 + c_0_1 + c_1_4 + c_1_1 + c_2_4 + c_2_0 + c_2_1) = 2))) ∧
  (c_1_1' = 1 ↔ ((c_0_0 + c_0_1 + c_0_2 + c_1_0 + c_1_2 + c_2_0 + c_2_1 + c_2_2) = 3 ∨ (c_1_1 = 1 ∧ (c_0_0 + c_0_1 + c_0_2 + c_1_0 + c_1_2 + c_2_0 + c_2_1 + c_2_2) = 2))) ∧
  (c_1_2' = 1 ↔ ((c_0_1 + c_0_2 + c_0_3 + c_1_1 + c_1_3 + c_2_1 + c_2_2 + c_2_3) = 3 ∨ (c_1_2 = 1 ∧ (c_0_1 + c_0_2 + c_0_3 + c_1_1 + c_1_3 + c_2_1 + c_2_2 + c_2_3) = 2))) ∧
  (c_1_3' = 1 ↔ ((c_0_2 + c_0_3 + c_0_4 + c_1_2 + c_1_4 + c_2_2 + c_2_3 + c_2_4) = 3 ∨ (c_1_3 = 1 ∧ (c_0_2 + c_0_3 + c_0_4 + c_1_2 + c_1_4 + c_2_2 + c_2_3 + c_2_4) = 2))) ∧
  (c_1_4' = 1 ↔ ((c_0_3 + c_0_4 + c_0_0 + c_1_3 + c_1_0 + c_2_3 + c_2_4 + c_2_0) = 3 ∨ (c_1_4 = 1 ∧ (c_0_3 + c_0_4 + c_0_0 + c_1_3 + c_1_0 + c_2_3 + c_2_4 + c_2_0) = 2))) ∧
  (c_2_0' = 1 ↔ ((c_1_4 + c_1_0 + c_1_1 + c_2_4 + c_2_1 + c_3_4 + c_3_0 + c_3_1) = 3 ∨ (c_2_0 = 1 ∧ (c_1_4 + c_1_0 + c_1_1 + c_2_4 + c_2_1 + c_3_4 + c_3_0 + c_3_1) = 2))) ∧
  (c_2_1' = 1 ↔ ((c_1_0 + c_1_1 + c_1_2 + c_2_0 + c_2_2 + c_3_0 + c_3_1 + c_3_2) = 3 ∨ (c_2_1 = 1 ∧ (c_1_0 + c_1_1 + c_1_2 + c_2_0 + c_2_2 + c_3_0 + c_3_1 + c_3_2) = 2))) ∧
  (c_2_2' = 1 ↔ ((c_1_1 + c_1_2 + c_1_3 + c_2_1 + c_2_3 + c_3_1 + c_3_2 + c_3_3) = 3 ∨ (c_2_2 = 1 ∧ (c_1_1 + c_1_2 + c_1_3 + c_2_1 + c_2_3 + c_3_1 + c_3_2 + c_3_3) = 2))) ∧
  (c_2_3' = 1 ↔ ((c_1_2 + c_1_3 + c_1_4 + c_2_2 + c_2_4 + c_3_2 + c_3_3 + c_3_4) = 3 ∨ (c_2_3 = 1 ∧ (c_1_2 + c_1_3 + c_1_4 + c_2_2 + c_2_4 + c_3_2 + c_3_3 + c_3_4) = 2))) ∧
  (c_2_4' = 1 ↔ ((c_1_3 + c_1_4 + c_1_0 + c_2_3 + c_2_0 + c_3_3 + c_3_4 + c_3_0) = 3 ∨ (c_2_4 = 1 ∧ (c_1_3 + c_1_4 + c_1_0 + c_2_3 + c_2_0 + c_3_3 + c_3_4 + c_3_0) = 2))) ∧
  (c_3_0' = 1 ↔ ((c_2_4 + c_2_0 + c_2_1 + c_3_4 + c_3_1 + c_4_4 + c_4_0 + c_4_1) = 3 ∨ (c_3_0 = 1 ∧ (c_2_4 + c_2_0 + c_2_1 + c_3_4 + c_3_1 + c_4_4 + c_4_0 + c_4_1) = 2))) ∧
  (c_3_1' = 1 ↔ ((c_2_0 + c_2_1 + c_2_2 + c_3_0 + c_3_2 + c_4_0 + c_4_1 + c_4_2) = 3 ∨ (c_3_1 = 1 ∧ (c_2_0 + c_2_1 + c_2_2 + c_3_0 + c_3_2 + c_4_0 + c_4_1 + c_4_2) = 2))) ∧
  (c_3_2' = 1 ↔ ((c_2_1 + c_2_2 + c_2_3 + c_3_1 + c_3_3 + c_4_1 + c_4_2 + c_4_3) = 3 ∨ (c_3_2 = 1 ∧ (c_2_1 + c_2_2 + c_2_3 + c_3_1 + c_3_3 + c_4_1 + c_4_2 + c_4_3) = 2))) ∧
  (c_3_3' = 1 ↔ ((c_2_2 + c_2_3 + c_2_4 + c_3_2 + c_3_4 + c_4_2 + c_4_3 + c_4_4) = 3 ∨ (c_3_3 = 1 ∧ (c_2_2 + c_2_3 + c_2_4 + c_3_2 + c_3_4 + c_4_2 + c_4_3 + c_4_4) = 2))) ∧
  (c_3_4' = 1 ↔ ((c_2_3 + c_2_4 + c_2_0 + c_3_3 + c_3_0 + c_4_3 + c_4_4 + c_4_0) = 3 ∨ (c_3_4 = 1 ∧ (c_2_3 + c_2_4 + c_2_0 + c_3_3 + c_3_0 + c_4_3 + c_4_4 + c_4_0) = 2))) ∧
  (c_4_0' = 1 ↔ ((c_3_4 + c_3_0 + c_3_1 + c_4_4 + c_4_1 + c_0_4 + c_0_0 + c_0_1) = 3 ∨ (c_4_0 = 1 ∧ (c_3_4 + c_3_0 + c_3_1 + c_4_4 + c_4_1 + c_0_4 + c_0_0 + c_0_1) = 2))) ∧
  (c_4_1' = 1 ↔ ((c_3_0 + c_3_1 + c_3_2 + c_4_0 + c_4_2 + c_0_0 + c_0_1 + c_0_2) = 3 ∨ (c_4_1 = 1 ∧ (c_3_0 + c_3_1 + c_3_2 + c_4_0 + c_4_2 + c_0_0 + c_0_1 + c_0_2) = 2))) ∧
  (c_4_2' = 1 ↔ ((c_3_1 + c_3_2 + c_3_3 + c_4_1 + c_4_3 + c_0_1 + c_0_2 + c_0_3) = 3 ∨ (c_4_2 = 1 ∧ (c_3_1 + c_3_2 + c_3_3 + c_4_1 + c_4_3 + c_0_1 + c_0_2 + c_0_3) = 2))) ∧
  (c_4_3' = 1 ↔ ((c_3_2 + c_3_3 + c_3_4 + c_4_2 + c_4_4 + c_0_2 + c_0_3 + c_0_4) = 3 ∨ (c_4_3 = 1 ∧ (c_3_2 + c_3_3 + c_3_4 + c_4_2 + c_4_4 + c_0_2 + c_0_3 + c_0_4) = 2))) ∧
  (c_4_4' = 1 ↔ ((c_3_3 + c_3_4 + c_3_0 + c_4_3 + c_4_0 + c_0_3 + c_0_4 + c_0_0) = 3 ∨ (c_4_4 = 1 ∧ (c_3_3 + c_3_4 + c_3_0 + c_4_3 + c_4_0 + c_0_3 + c_0_4 + c_0_0) = 2)))
}

// --- Safety properties (BMC-friendly) ---

// A glider has exactly 5 live cells; GoL preserves population for gliders.
property population_is_five {
  □ ((c_0_0 + c_0_1 + c_0_2 + c_0_3 + c_0_4 + c_1_0 + c_1_1 + c_1_2 + c_1_3 + c_1_4 + c_2_0 + c_2_1 + c_2_2 + c_2_3 + c_2_4 + c_3_0 + c_3_1 + c_3_2 + c_3_3 + c_3_4 + c_4_0 + c_4_1 + c_4_2 + c_4_3 + c_4_4) = 5)
}

// The glider never goes extinct.
property never_all_dead {
  □ ¬ (c_0_0 = 0 ∧ c_0_1 = 0 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_0_4 = 0 ∧ c_1_0 = 0 ∧ c_1_1 = 0 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_1_4 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_2_4 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0 ∧ c_3_4 = 0 ∧ c_4_0 = 0 ∧ c_4_1 = 0 ∧ c_4_2 = 0 ∧ c_4_3 = 0 ∧ c_4_4 = 0)
}

// --- Liveness (only the explicit engine handles these in v1) ---

// The glider eventually returns to its starting position (period 20 on a
// 5x5 torus = 4 step cycle * 5 cells of diagonal translation).
property eventually_returns_to_start {
  □ ◇ (c_0_0 = 0 ∧ c_0_1 = 1 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_0_4 = 0 ∧ c_1_0 = 0 ∧ c_1_1 = 0 ∧ c_1_2 = 1 ∧ c_1_3 = 0 ∧ c_1_4 = 0 ∧ c_2_0 = 1 ∧ c_2_1 = 1 ∧ c_2_2 = 1 ∧ c_2_3 = 0 ∧ c_2_4 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0 ∧ c_3_4 = 0 ∧ c_4_0 = 0 ∧ c_4_1 = 0 ∧ c_4_2 = 0 ∧ c_4_3 = 0 ∧ c_4_4 = 0)
}

// --- Deliberately false ---

// Population can never reach 6 — would require a birth somewhere with
// nothing dying, which the GoL rule forbids for a 5-cell starting pattern.
invalid population_reaches_six {
  ◇ ((c_0_0 + c_0_1 + c_0_2 + c_0_3 + c_0_4 + c_1_0 + c_1_1 + c_1_2 + c_1_3 + c_1_4 + c_2_0 + c_2_1 + c_2_2 + c_2_3 + c_2_4 + c_3_0 + c_3_1 + c_3_2 + c_3_3 + c_3_4 + c_4_0 + c_4_1 + c_4_2 + c_4_3 + c_4_4) = 6)
}
