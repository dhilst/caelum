module examples.life4x4_multipattern

// Conway's Game of Life on a 4x4 toroidal grid with four selectable
// starting configurations discriminated by `mode`. The transition preserves
// `mode` and applies the GoL rule to every cell.

type Mode = enum { block, tub, blinker, fade }

let mode ∈ Mode
let c_0_0 ∈ 0..1
let c_0_1 ∈ 0..1
let c_0_2 ∈ 0..1
let c_0_3 ∈ 0..1
let c_1_0 ∈ 0..1
let c_1_1 ∈ 0..1
let c_1_2 ∈ 0..1
let c_1_3 ∈ 0..1
let c_2_0 ∈ 0..1
let c_2_1 ∈ 0..1
let c_2_2 ∈ 0..1
let c_2_3 ∈ 0..1
let c_3_0 ∈ 0..1
let c_3_1 ∈ 0..1
let c_3_2 ∈ 0..1
let c_3_3 ∈ 0..1

init {
  (mode = block ∧ c_0_0 = 1 ∧ c_0_1 = 1 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 1 ∧ c_1_1 = 1 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0) ∨
  (mode = tub ∧ c_0_0 = 0 ∧ c_0_1 = 1 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 1 ∧ c_1_1 = 0 ∧ c_1_2 = 1 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 1 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0) ∨
  (mode = blinker ∧ c_0_0 = 0 ∧ c_0_1 = 1 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 0 ∧ c_1_1 = 1 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 1 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0) ∨
  (mode = fade ∧ c_0_0 = 1 ∧ c_0_1 = 1 ∧ c_0_2 = 1 ∧ c_0_3 = 1 ∧ c_1_0 = 1 ∧ c_1_1 = 1 ∧ c_1_2 = 1 ∧ c_1_3 = 1 ∧ c_2_0 = 1 ∧ c_2_1 = 1 ∧ c_2_2 = 1 ∧ c_2_3 = 1 ∧ c_3_0 = 1 ∧ c_3_1 = 1 ∧ c_3_2 = 1 ∧ c_3_3 = 1)
}

transition step {
  mode' = mode ∧
  (c_0_0' = 1 ↔ ((c_3_3 + c_3_0 + c_3_1 + c_0_3 + c_0_1 + c_1_3 + c_1_0 + c_1_1) = 3 ∨ (c_0_0 = 1 ∧ (c_3_3 + c_3_0 + c_3_1 + c_0_3 + c_0_1 + c_1_3 + c_1_0 + c_1_1) = 2))) ∧
  (c_0_1' = 1 ↔ ((c_3_0 + c_3_1 + c_3_2 + c_0_0 + c_0_2 + c_1_0 + c_1_1 + c_1_2) = 3 ∨ (c_0_1 = 1 ∧ (c_3_0 + c_3_1 + c_3_2 + c_0_0 + c_0_2 + c_1_0 + c_1_1 + c_1_2) = 2))) ∧
  (c_0_2' = 1 ↔ ((c_3_1 + c_3_2 + c_3_3 + c_0_1 + c_0_3 + c_1_1 + c_1_2 + c_1_3) = 3 ∨ (c_0_2 = 1 ∧ (c_3_1 + c_3_2 + c_3_3 + c_0_1 + c_0_3 + c_1_1 + c_1_2 + c_1_3) = 2))) ∧
  (c_0_3' = 1 ↔ ((c_3_2 + c_3_3 + c_3_0 + c_0_2 + c_0_0 + c_1_2 + c_1_3 + c_1_0) = 3 ∨ (c_0_3 = 1 ∧ (c_3_2 + c_3_3 + c_3_0 + c_0_2 + c_0_0 + c_1_2 + c_1_3 + c_1_0) = 2))) ∧
  (c_1_0' = 1 ↔ ((c_0_3 + c_0_0 + c_0_1 + c_1_3 + c_1_1 + c_2_3 + c_2_0 + c_2_1) = 3 ∨ (c_1_0 = 1 ∧ (c_0_3 + c_0_0 + c_0_1 + c_1_3 + c_1_1 + c_2_3 + c_2_0 + c_2_1) = 2))) ∧
  (c_1_1' = 1 ↔ ((c_0_0 + c_0_1 + c_0_2 + c_1_0 + c_1_2 + c_2_0 + c_2_1 + c_2_2) = 3 ∨ (c_1_1 = 1 ∧ (c_0_0 + c_0_1 + c_0_2 + c_1_0 + c_1_2 + c_2_0 + c_2_1 + c_2_2) = 2))) ∧
  (c_1_2' = 1 ↔ ((c_0_1 + c_0_2 + c_0_3 + c_1_1 + c_1_3 + c_2_1 + c_2_2 + c_2_3) = 3 ∨ (c_1_2 = 1 ∧ (c_0_1 + c_0_2 + c_0_3 + c_1_1 + c_1_3 + c_2_1 + c_2_2 + c_2_3) = 2))) ∧
  (c_1_3' = 1 ↔ ((c_0_2 + c_0_3 + c_0_0 + c_1_2 + c_1_0 + c_2_2 + c_2_3 + c_2_0) = 3 ∨ (c_1_3 = 1 ∧ (c_0_2 + c_0_3 + c_0_0 + c_1_2 + c_1_0 + c_2_2 + c_2_3 + c_2_0) = 2))) ∧
  (c_2_0' = 1 ↔ ((c_1_3 + c_1_0 + c_1_1 + c_2_3 + c_2_1 + c_3_3 + c_3_0 + c_3_1) = 3 ∨ (c_2_0 = 1 ∧ (c_1_3 + c_1_0 + c_1_1 + c_2_3 + c_2_1 + c_3_3 + c_3_0 + c_3_1) = 2))) ∧
  (c_2_1' = 1 ↔ ((c_1_0 + c_1_1 + c_1_2 + c_2_0 + c_2_2 + c_3_0 + c_3_1 + c_3_2) = 3 ∨ (c_2_1 = 1 ∧ (c_1_0 + c_1_1 + c_1_2 + c_2_0 + c_2_2 + c_3_0 + c_3_1 + c_3_2) = 2))) ∧
  (c_2_2' = 1 ↔ ((c_1_1 + c_1_2 + c_1_3 + c_2_1 + c_2_3 + c_3_1 + c_3_2 + c_3_3) = 3 ∨ (c_2_2 = 1 ∧ (c_1_1 + c_1_2 + c_1_3 + c_2_1 + c_2_3 + c_3_1 + c_3_2 + c_3_3) = 2))) ∧
  (c_2_3' = 1 ↔ ((c_1_2 + c_1_3 + c_1_0 + c_2_2 + c_2_0 + c_3_2 + c_3_3 + c_3_0) = 3 ∨ (c_2_3 = 1 ∧ (c_1_2 + c_1_3 + c_1_0 + c_2_2 + c_2_0 + c_3_2 + c_3_3 + c_3_0) = 2))) ∧
  (c_3_0' = 1 ↔ ((c_2_3 + c_2_0 + c_2_1 + c_3_3 + c_3_1 + c_0_3 + c_0_0 + c_0_1) = 3 ∨ (c_3_0 = 1 ∧ (c_2_3 + c_2_0 + c_2_1 + c_3_3 + c_3_1 + c_0_3 + c_0_0 + c_0_1) = 2))) ∧
  (c_3_1' = 1 ↔ ((c_2_0 + c_2_1 + c_2_2 + c_3_0 + c_3_2 + c_0_0 + c_0_1 + c_0_2) = 3 ∨ (c_3_1 = 1 ∧ (c_2_0 + c_2_1 + c_2_2 + c_3_0 + c_3_2 + c_0_0 + c_0_1 + c_0_2) = 2))) ∧
  (c_3_2' = 1 ↔ ((c_2_1 + c_2_2 + c_2_3 + c_3_1 + c_3_3 + c_0_1 + c_0_2 + c_0_3) = 3 ∨ (c_3_2 = 1 ∧ (c_2_1 + c_2_2 + c_2_3 + c_3_1 + c_3_3 + c_0_1 + c_0_2 + c_0_3) = 2))) ∧
  (c_3_3' = 1 ↔ ((c_2_2 + c_2_3 + c_2_0 + c_3_2 + c_3_0 + c_0_2 + c_0_3 + c_0_0) = 3 ∨ (c_3_3 = 1 ∧ (c_2_2 + c_2_3 + c_2_0 + c_3_2 + c_3_0 + c_0_2 + c_0_3 + c_0_0) = 2)))
}

// --- Per-mode invariants ---

// The 2x2 block is a still life on a torus.
property block_is_still {
  □ (mode = block → (c_0_0 = 1 ∧ c_0_1 = 1 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 1 ∧ c_1_1 = 1 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0))
}

// The tub is a still life on a torus.
property tub_is_still {
  □ (mode = tub → (c_0_0 = 0 ∧ c_0_1 = 1 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 1 ∧ c_1_1 = 0 ∧ c_1_2 = 1 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 1 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0))
}

// The blinker oscillates between vertical and horizontal phases.
property blinker_is_two_phase {
  □ (mode = blinker → ((c_0_0 = 0 ∧ c_0_1 = 1 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 0 ∧ c_1_1 = 1 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 1 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0) ∨ (c_0_0 = 0 ∧ c_0_1 = 0 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 1 ∧ c_1_1 = 1 ∧ c_1_2 = 1 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0)))
}

// The blinker eventually returns to its vertical phase.
property blinker_returns {
  □ (mode = blinker → ◇ (c_0_0 = 0 ∧ c_0_1 = 1 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 0 ∧ c_1_1 = 1 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 1 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0))
}

// All-alive on a 4x4 torus dies in one step.
property fade_eventually_dead {
  □ (mode = fade → ◇ (c_0_0 = 0 ∧ c_0_1 = 0 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 0 ∧ c_1_1 = 0 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0))
}

// All-dead is absorbing: once dead, always dead.
property dead_is_absorbing {
  □ ((mode = fade ∧ (c_0_0 = 0 ∧ c_0_1 = 0 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 0 ∧ c_1_1 = 0 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0)) → ◯ (c_0_0 = 0 ∧ c_0_1 = 0 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 0 ∧ c_1_1 = 0 ∧ c_1_2 = 0 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 0 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0))
}

// Still lifes have population 4.
property still_lifes_have_four {
  □ ((mode = block ∨ mode = tub) → (c_0_0 + c_0_1 + c_0_2 + c_0_3 + c_1_0 + c_1_1 + c_1_2 + c_1_3 + c_2_0 + c_2_1 + c_2_2 + c_2_3 + c_3_0 + c_3_1 + c_3_2 + c_3_3) = 4)
}

// The blinker has population 3.
property blinker_population_three {
  □ (mode = blinker → (c_0_0 + c_0_1 + c_0_2 + c_0_3 + c_1_0 + c_1_1 + c_1_2 + c_1_3 + c_2_0 + c_2_1 + c_2_2 + c_2_3 + c_3_0 + c_3_1 + c_3_2 + c_3_3) = 3)
}

// --- Mode is preserved (sanity check). ---

property mode_never_changes_to_block {
  □ (mode ≠ block → ◯ (mode ≠ block))
}

// --- Deliberately false properties ---

// The block does NOT start as a tub, so this universal claim is wrong.
invalid all_modes_start_as_tub {
  (c_0_0 = 0 ∧ c_0_1 = 1 ∧ c_0_2 = 0 ∧ c_0_3 = 0 ∧ c_1_0 = 1 ∧ c_1_1 = 0 ∧ c_1_2 = 1 ∧ c_1_3 = 0 ∧ c_2_0 = 0 ∧ c_2_1 = 1 ∧ c_2_2 = 0 ∧ c_2_3 = 0 ∧ c_3_0 = 0 ∧ c_3_1 = 0 ∧ c_3_2 = 0 ∧ c_3_3 = 0)
}

// "Fade" reaches all-dead but does not stay all-alive forever.
invalid fade_stays_alive {
  □ (c_0_0 = 1 ∧ c_0_1 = 1 ∧ c_0_2 = 1 ∧ c_0_3 = 1 ∧ c_1_0 = 1 ∧ c_1_1 = 1 ∧ c_1_2 = 1 ∧ c_1_3 = 1 ∧ c_2_0 = 1 ∧ c_2_1 = 1 ∧ c_2_2 = 1 ∧ c_2_3 = 1 ∧ c_3_0 = 1 ∧ c_3_1 = 1 ∧ c_3_2 = 1 ∧ c_3_3 = 1)
}
